<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>GEMS.GameAssistant</AssemblyName>
    <RootNamespace>Gems.GameAssistant</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.1.85-dev.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ScriptHookVDotNet3"><HintPath>third_party/shvdne/package/ScriptHookVDotNet3.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Runtime.Serialization" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
</Project>
